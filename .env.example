# --- Last.fm account (all required) ---
# The web session is the only way to edit scrobbles; there is no API for it, so the
# password is genuinely needed. chmod 600 this file.
LASTFM_USERNAME=
LASTFM_PASSWORD=
# Read-only API key for the sweep: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# --- Storage ---
# The ledger. `.data/session.json` (the cookie jar) is derived from this path's directory.
DB_PATH=.data/scrobble-scrubber.sqlite

# --- Reporting ---
# Optional. Gets a per-sweep summary and any auth failure. Without it, silent breakage
# is only visible in journalctl.
DISCORD_WEBHOOK_URL=

# --- Safety ---
# Defaults to true. Plans and logs every edit but writes nothing. Leave it on for the
# first sweep on a new account: the edits are irreversible and `edit_all` widens each
# one to every scrobble sharing the tuple.
DRY_RUN=true

# Comma lists of rule groups. Anything not listed is off.
#   stable:       remaster, edition, bonus
#   experimental: feat-album, feat-track, ep-single, live, version, mono-stereo
# An unknown name is a startup error, so a typo can't silently disable a group.
RULES_ENABLED=remaster,edition,bonus
# feat-track, live, version and mono-stereo distinguish *different recordings* — enabling
# them merges things that arguably should stay apart, and it cannot be undone.
RULES_EXPERIMENTAL_ENABLED=

# --- Pacing ---
# Full sweep cadence. There is no scrobble cursor: each sweep re-enumerates everything,
# which is cheap (~250 API calls) and stateless.
SWEEP_INTERVAL_MS=21600000
# Write cap per sweep, so a bad ruleset can only do bounded damage before you notice.
MAX_EDITS_PER_RUN=250
# Spacing between writes. Writes are serial regardless; the web endpoint's rate limit
# is undocumented, so this is deliberately conservative.
WRITE_DELAY_MS=3000

# --- Verification ---
# Re-read each edited row to confirm it actually changed. Last.fm returns 200 for an
# accepted-but-no-op edit, so without this a silent failure looks like success.
VERIFY_EDITS=true
# Last.fm serves stale rows for a moment after a write, so verifying immediately would
# report false failures.
VERIFY_DELAY_MS=2000
VERIFY_ATTEMPTS=3

# --- Advanced ---
# Last.fm answers any Mozilla/5.0-prefixed User-Agent with 406. Identify honestly.
# USER_AGENT=scrobble-scrubber/0.1.0 (+https://github.com/mxttbennett/scrobble-scrubber)
