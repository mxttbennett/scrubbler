# --- Last.fm account (all required) ---
# The web session is the only way to edit scrobbles; there is no API for it, so the
# password is genuinely needed. chmod 600 this file.
LASTFM_USERNAME=
LASTFM_PASSWORD=
# Read-only API key for the sweep: https://www.last.fm/api/account/create
LASTFM_API_KEY=

# --- Storage ---
# The ledger. `.data/session.json` (the cookie jar) is derived from this path's directory.
DB_PATH=.data/scrubbler.sqlite

# --- Reporting ---
# Optional, and both are needed together or Discord stays off. Create a bot at
# https://discord.com/developers/applications -> Bot -> Reset Token, invite it to the server
# with the "Send Messages" permission, then right-click the target channel -> Copy Channel ID
# (Developer Mode must be on in Discord's Advanced settings).
#
# These two alone give you reports over the REST API and no gateway, so the bot shows as OFFLINE
# in the member list. Add OWNER and GUILD below to get slash commands, which needs a connection.
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=

# Set these to get the /scrub command surface. Independent of APPROVAL_MODE: status, stats, pause,
# resume, replace, rules, resweep and retry-dead are all useful unattended. Providing them opens a
# gateway connection, so the bot then shows ONLINE. OWNER is the only account whose commands and
# clicks are honoured; GUILD scopes the commands, which registers instantly rather than in an hour.
# DISCORD_OWNER_ID=
# DISCORD_GUILD_ID=

# Corrections per Discord message. 1 (the default) reports every correction individually as a
# structured embed with before/after fields. Raise it to batch into a code-fenced digest instead,
# which is quieter for a large backfill. The sender is rate limited either way, so 1 is safe.
DIGEST_EVERY=1

# --- Safety ---
# Defaults to true. Plans and logs every edit but writes nothing. Leave it on for the
# first sweep on a new account: the edits are irreversible and `edit_all` widens each
# one to every scrobble sharing the tuple.
DRY_RUN=true

# Comma lists of rule groups. Anything not listed is off.
#   stable:       remaster, edition, bonus
#   experimental: feat-album, feat-track, ep-single, live, version, mono-stereo
# An unknown name is a startup error, so a typo can't silently disable a group.
RULES_ENABLED=remaster,edition,bonus
# feat-track, live, version and mono-stereo distinguish *different recordings* — enabling
# them merges things that arguably should stay apart, and it cannot be undone.
RULES_EXPERIMENTAL_ENABLED=
# feat-album and feat-track remove a "(feat. X)" credit. On an album title that is store cruft; on
# a track title it deletes who is on the recording, which the API will not give back. Enable both
# only if you want titles normalised and accept losing the credit.
# live-track strips a bare "- Live" or "(Live)" from a TRACK, which merges it with the studio take
# you probably also own. Off, and worth leaving off unless you never want live takes counted apart.
# Neither live nor feat touches "Live at Leeds", "Live from the Basement" or "- Live in Rotterdam
# 1984": the whole trailing segment must match, never a substring.

# --- Pacing ---
# How often a cycle runs. Most cycles are incremental: they poll only scrobbles newer than the
# stored cursor, which is seconds rather than ~250 API calls.
SWEEP_INTERVAL_MS=21600000
# How often a FULL library sweep runs anyway, as a completeness guarantee in case a scrobble ever
# lands out of order or a history import backfills. Weekly by default; `--resweep` forces one.
FULL_SWEEP_INTERVAL_MS=604800000
# After this many passes where a candidate resolves to nothing (an album with no scrobbles under
# that exact title, say), stop asking. Each such candidate otherwise costs a paced page fetch every
# cycle forever. `--retry-dead` clears the memory.
DEAD_CANDIDATE_ATTEMPTS=3
# Write cap per sweep. Resolution costs hours regardless of how many writes follow, so a low cap
# means paying that cost repeatedly; 2000 lets one sweep clear a whole backlog. Lower it if you
# want a hard ceiling on how much a bad ruleset could change before you notice.
MAX_EDITS_PER_RUN=2000
# Spacing between writes. Writes are serial regardless; the web endpoint's rate limit
# is undocumented, so this is deliberately conservative.
WRITE_DELAY_MS=3000
# Spacing between library page reads. Last.fm soft-throttles the web pages with an
# HTTP 200 error page ("You're requesting too many pages") long before the API complains.
# 1.5s still tripped it; 15s (~4 requests/minute) is comfortably below any limit. A full
# first pass then takes a few hours, which is fine for a service that runs continuously.
PAGE_DELAY_MS=15000
# Random spread added on top, so each read waits 15-20s. Not camouflage — the User-Agent
# identifies this service by name. It decorrelates the cadence from any fixed rate-limit
# window, and stops requests re-synchronising after a shared backoff.
PAGE_DELAY_JITTER_MS=5000

# --- Verification ---
# Re-read each edited row to confirm it actually changed. Last.fm returns 200 for an
# accepted-but-no-op edit, so without this a silent failure looks like success.
VERIFY_EDITS=true
# Last.fm serves stale rows for a moment after a write, so verifying immediately would
# report false failures.
VERIFY_DELAY_MS=2000
VERIFY_ATTEMPTS=3

# How long to let an in-flight edit and its verification finish on SIGTERM before exiting anyway.
# The systemd unit allows 90s for this.
SHUTDOWN_GRACE_MS=60000

# --- Approval mode ---
# Off means the service corrects unattended and reports what it did. On means every candidate
# becomes one Discord card with Apply/Never buttons and nothing is written until you click.
# Read once at startup: switching it needs a restart. Use /scrub pause for a live stop.
APPROVAL_MODE=false

# DISCORD_OWNER_ID and DISCORD_GUILD_ID (above) are *required* when APPROVAL_MODE=true — startup
# refuses without them, because a proposal nobody can see or click is worse than no gate at all.

# A proposal older than this becomes `expired` and its edits go back to `planned`, so an unread
# week is re-proposed rather than silently discarded. A week by default.
APPROVAL_TTL_HOURS=168

# The REST sender swallows failures by design, so a dead websocket has no other way to surface.
# Alert if the gateway stays disconnected this long.
GATEWAY_ALERT_MINUTES=15

# --- Shadow mode ---
# While an experimental rule is OFF, report what it *would* have changed, in a violet embed, so it
# can be vetted against the real library before it is trusted with it. Writes nothing to Last.fm.
# Off by default like DRY_RUN and APPROVAL_MODE, because turning it on changes what the channel
# shows. Measured on a real library: live-track 138 tracks, feat-track 272, feat-album 20.
SHADOW_MODE=false

# One card per hit is a lot on the first full sweep, so posting is capped per cycle and the rest
# carry over to the next one. Nothing is lost either way: every hit is recorded and readable with
# /scrub shadow. 0 records without posting at all.
SHADOW_MAX_PER_SWEEP=50

# --- Advanced ---
# Last.fm answers any Mozilla/5.0-prefixed User-Agent with 406. Identify honestly.
# USER_AGENT=scrubbler/0.1.0 (+https://github.com/mxttbennett/scrubbler)
